# Site URL for canonical links and sitemap generation
SITE_URL=https://pottery-studio-astro.vercel.app

# Penpot Remote MCP (optional if using Local MCP at http://localhost:4401/mcp)
# Generate at https://design.penpot.app -> Account -> Integrations -> MCP Server
PENPOT_MCP_KEY=

# Unsplash MCP (optional; design-taste-frontend photos.mjs works without API key)
UNSPLASH_ACCESS_KEY=

# Keystatic GitHub Mode (only needed when deploying /keystatic admin UI to production)
ENABLE_KEYSTATIC_SSR=false
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=

---
import { ClientRouter } from 'astro:transitions';
import { getEntry } from 'astro:content';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  ogImage = '/og-default.png',
  ogType = 'website',
  jsonLd,
} = Astro.props;

const studioEntry = await getEntry('studio', 'profile');
const studio = studioEntry?.data ?? {
  brandName: 'Silt & Kiln',
  headline: 'Wheel-thrown stoneware for dining rooms and architectural interiors.',
  subline: 'Small-batch vessels, tableware, and ceramic lighting thrown and reduction-fired at 1,260°C in Melle.',
  kilnBatch: 'Kiln Opening No. 14 · Live',
  location: 'Melle, Germany · CET',
  hours: 'Studio visits by appointment · Thu–Sat 11:00–17:00',
  email: 'studio@siltandkiln.com',
  disclosure: 'Self-initiated ceramic brand & product showcase.',
  craftStages: [],
};

const siteOrigin = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';
const canonicalUrl = siteOrigin ? new URL(Astro.url.pathname, siteOrigin).toString() : undefined;
const resolvedOgImage = siteOrigin && ogImage.startsWith('/') ? `${siteOrigin}${ogImage}` : ogImage;

const defaultOrgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: studio.brandName,
  description: studio.subline,
  email: studio.email,
  ...(siteOrigin ? { url: siteOrigin } : {}),
};

const structuredData = jsonLd ?? defaultOrgSchema;
---

<!doctype html>
<html lang="en" data-theme="light" data-type="place">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="page-type" content="place" />
    <meta name="site-kind" content="other" />
    <meta name="page-kind" content="place" />
    <meta name="theme-color" content="#F7F4EE" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={resolvedOgImage} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Host+Grotesk:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap"
    />

    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('sk-theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.dataset.theme = saved;
          }
        } catch (e) {}
      })();
      document.addEventListener('astro:after-swap', function () {
        try {
          var saved = localStorage.getItem('sk-theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.dataset.theme = saved;
          }
        } catch (e) {}
      });
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <SiteHeader
      brandName={studio.brandName}
      subline={studio.subline}
      kilnBatch={studio.kilnBatch}
      location={studio.location}
      email={studio.email}
      currentPath={Astro.url.pathname}
    />
    <div class="flex min-h-dvh flex-col lg:pl-[280px]">
      <main id="main-content" class="flex-1">
        <slot />
      </main>
      <SiteFooter
        brandName={studio.brandName}
        email={studio.email}
        location={studio.location}
        hours={studio.hours}
        disclosure={studio.disclosure}
      />
    </div>
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>

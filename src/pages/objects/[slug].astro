---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseImage from '../../components/CaseImage.astro';

export async function getStaticPaths() {
  const entries = await getCollection('objects');
  const sorted = entries.sort((a, b) => a.data.order - b.data.order);

  return sorted.map((entry, index) => {
    const nextEntry = sorted[(index + 1) % sorted.length];
    return {
      params: { slug: entry.id },
      props: { entry, nextEntry },
    };
  });
}

const { entry, nextEntry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;

const siteOrigin = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: data.title,
  description: data.summary,
  category: data.category,
  material: data.clayBody,
  offers: {
    '@type': 'Offer',
    priceCurrency: 'EUR',
    price: String(data.priceEur),
    availability: 'https://schema.org/InStock',
  },
  ...(siteOrigin && data.coverImage ? { image: `${siteOrigin}${data.coverImage}` } : {}),
};
---

<BaseLayout
  title={`${data.title} · Silt & Kiln`}
  description={data.summary}
  ogImage={data.coverImage || '/og-default.png'}
  ogType="article"
  jsonLd={productSchema}
>
  <article class="pt-10 pb-20 md:pt-12 md:pb-28">
    <div class="studio-wrap">
      <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
        <a
          href="/#objects"
          class="inline-flex min-h-[44px] items-center gap-2 text-[0.9375rem] font-medium text-[var(--color-muted)] hover:text-[var(--color-ink)]"
        >
          <span aria-hidden="true">&larr;</span>
          <span>All objects</span>
        </a>

        <span class="font-mono text-[0.75rem] uppercase tracking-[0.05em] text-[var(--color-accent)]">
          {data.category} · {data.availability}
        </span>
      </div>

      <!-- Product Hero Split: Primary Photo + Purchase / Glaze Controls -->
      <div class="grid grid-cols-1 gap-10 border-b border-[var(--color-border)] pb-14 md:grid-cols-12 md:items-start">
        <div class="overflow-hidden bg-[var(--color-surface)] md:col-span-7">
          <CaseImage
            src={data.coverImage}
            alt={data.coverAlt || data.title}
            eager={true}
            sizes="(max-width: 1023px) 100vw, 50vw"
            class="aspect-[4/3] w-full object-cover md:aspect-[5/4]"
          />
        </div>

        <div class="flex flex-col gap-6 md:col-span-5">
          <div>
            <p class="font-mono text-[0.75rem] uppercase tracking-[0.05em] text-[var(--color-muted)]">
              {data.clayBody} · {data.firingTemp}
            </p>
            <h1
              data-motion="hero"
              class="mt-2 text-[clamp(2rem,3.8vw,3rem)] font-normal leading-[1.08] tracking-[-0.03em] text-[var(--color-ink)]"
            >
              {data.title}
            </h1>
            <p class="mt-3 font-mono text-[1.375rem] font-medium text-[var(--color-ink)]">
              {data.priceLabel}
            </p>
          </div>

          <p class="text-[1rem] leading-[1.65] text-[var(--color-muted)]">
            {data.summary}
          </p>

          {data.glazes.length > 0 && (
            <div class="border-t border-[var(--color-border)] pt-5">
              <div class="flex items-center justify-between">
                <span class="font-mono text-[0.75rem] uppercase tracking-[0.05em] text-[var(--color-muted)]">
                  Glaze Finish
                </span>
                <span id="selected-glaze-label" class="font-mono text-[0.8125rem] text-[var(--color-ink)]">
                  {data.glazes[0].name} ({data.glazes[0].finish})
                </span>
              </div>

              <div role="group" aria-label="Select glaze finish" class="mt-3 flex flex-wrap gap-2.5">
                {data.glazes.map((glaze, idx) => (
                  <button
                    type="button"
                    data-glaze-btn
                    data-glaze-name={glaze.name}
                    data-glaze-finish={glaze.finish}
                    aria-pressed={idx === 0 ? 'true' : 'false'}
                    class={`inline-flex min-h-[44px] items-center gap-2.5 rounded-[2px] border px-3.5 text-[0.875rem] font-medium ${
                      idx === 0
                        ? 'border-[var(--color-ink)] bg-[var(--color-surface)] text-[var(--color-ink)]'
                        : 'border-[var(--color-border)] bg-[var(--color-canvas)] text-[var(--color-ink)] hover:border-[var(--color-ink)]'
                    }`}
                  >
                    <span
                      class="h-4 w-4 rounded-full border border-black/15"
                      style={`background-color: ${glaze.hex};`}
                      aria-hidden="true"
                    />
                    <span>{glaze.name}</span>
                  </button>
                ))}
              </div>
            </div>
          )}

          <div class="flex flex-col gap-3 pt-2">
            <button
              type="button"
              id="add-to-bag-btn"
              data-slug={entry.id}
              data-title={data.title}
              data-price={data.priceEur}
              data-default-glaze={data.glazes[0]?.name || 'Standard Glaze'}
              class="inline-flex min-h-[48px] w-full items-center justify-center rounded-[2px] bg-[var(--color-accent)] px-6 text-[0.9375rem] font-medium text-[var(--color-accent-on)] hover:bg-[var(--color-accent-hover)]"
            >
              Add to inquiry bag
            </button>
            <p id="add-bag-status" role="status" aria-live="polite" class="font-mono text-[0.75rem] text-[var(--color-muted)]">
              {data.availability}
            </p>
          </div>

          <dl class="grid grid-cols-1 gap-3 border-t border-[var(--color-border)] pt-5 text-[0.875rem]">
            <div class="flex justify-between gap-4 border-b border-[var(--color-border)] pb-2.5">
              <dt class="font-mono text-[0.75rem] uppercase text-[var(--color-muted)]">Dimensions</dt>
              <dd class="font-medium text-[var(--color-ink)]">{data.dimensions}</dd>
            </div>
            <div class="flex justify-between gap-4 border-b border-[var(--color-border)] pb-2.5">
              <dt class="font-mono text-[0.75rem] uppercase text-[var(--color-muted)]">Clay Body</dt>
              <dd class="font-medium text-[var(--color-ink)]">{data.clayBody}</dd>
            </div>
            <div class="flex justify-between gap-4 border-b border-[var(--color-border)] pb-2.5">
              <dt class="font-mono text-[0.75rem] uppercase text-[var(--color-muted)]">Firing</dt>
              <dd class="font-medium text-[var(--color-ink)]">{data.firingTemp}</dd>
            </div>
            <div class="pt-1">
              <dt class="font-mono text-[0.75rem] uppercase text-[var(--color-muted)]">Care &amp; Use</dt>
              <dd class="mt-1 leading-relaxed text-[var(--color-muted)]">{data.careNotes}</dd>
            </div>
          </dl>
        </div>
      </div>

      <!-- Editorial Provenance & Notes -->
      <div class="mt-14 grid grid-cols-1 gap-12 md:grid-cols-12">
        <div class="editorial-prose md:col-span-8">
          <Content />
        </div>
      </div>

      <!-- Multi-Image Product Gallery -->
      {data.gallery.length > 0 && (
        <section aria-labelledby="gallery-heading" class="mt-14 border-t border-[var(--color-border)] pt-14 md:mt-20 md:pt-16">
          <h2 id="gallery-heading" class="mb-8 font-mono text-[0.75rem] uppercase tracking-[0.06em] text-[var(--color-muted)]">
            Detail &amp; Studio Studies ({data.gallery.length})
          </h2>
          <div class="grid grid-cols-1 gap-6 md:grid-cols-12">
            {data.gallery.map((item, idx) => {
              const isFull = data.gallery.length === 3 && idx === 2;
              const colClass = isFull ? 'md:col-span-12' : idx % 2 === 0 ? 'md:col-span-7 md:h-[420px]' : 'md:col-span-5 md:h-[420px]';
              const aspectClass = isFull ? 'aspect-[16/9] md:aspect-[21/9]' : 'aspect-[4/3] md:aspect-auto md:h-full';
              return (
                <div class={`overflow-hidden bg-[var(--color-surface)] ${colClass}`}>
                  <CaseImage
                    src={item.image}
                    alt={item.alt}
                    sizes={isFull ? '(max-width: 1023px) 100vw, 80vw' : '(max-width: 1023px) 100vw, 45vw'}
                    class={`w-full object-cover ${aspectClass}`}
                  />
                </div>
              );
            })}
          </div>
        </section>
      )}

      <!-- Next Object -->
      {nextEntry && nextEntry.id !== entry.id && (
        <nav aria-label="Next ceramic object" class="mt-16 border-t border-[var(--color-border)] pt-12 md:mt-24">
          <p class="font-mono text-[0.75rem] uppercase tracking-[0.06em] text-[var(--color-muted)]">
            Next Object
          </p>
          <a
            href={`/objects/${nextEntry.id}`}
            class="group mt-3 grid grid-cols-1 items-center gap-6 border border-[var(--color-border)] bg-[var(--color-surface)] p-5 hover:border-[var(--color-ink)] md:grid-cols-12 md:p-6"
          >
            <div class="overflow-hidden bg-[var(--color-canvas)] md:col-span-4">
              <CaseImage
                src={nextEntry.data.coverImage}
                alt={nextEntry.data.coverAlt || nextEntry.data.title}
                widths={[360, 640]}
                sizes="(max-width: 767px) 100vw, 28vw"
                class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
            </div>
            <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center md:col-span-8">
              <div>
                <h2 class="text-[1.75rem] font-medium tracking-[-0.025em] text-[var(--color-ink)] group-hover:text-[var(--color-accent)] md:text-[2.25rem]">
                  {nextEntry.data.title}
                </h2>
                <p class="mt-1 font-mono text-[0.875rem] text-[var(--color-muted)]">
                  {nextEntry.data.category} · {nextEntry.data.priceLabel}
                </p>
              </div>
              <span class="inline-flex min-h-[44px] shrink-0 items-center font-medium text-[var(--color-accent)]">
                Open object &rarr;
              </span>
            </div>
          </a>
        </nav>
      )}
    </div>
  </article>
</BaseLayout>

<script>
  function setupObjectDetail() {
    const glazeBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-glaze-btn]'));
    const glazeLabel = document.getElementById('selected-glaze-label');
    const addBtn = document.getElementById('add-to-bag-btn') as HTMLButtonElement | null;
    const addStatus = document.getElementById('add-bag-status');

    let activeGlaze = addBtn?.dataset.defaultGlaze || 'Standard Glaze';

    for (const btn of glazeBtns) {
      if (btn.dataset.bound === 'true') continue;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', () => {
        const name = btn.dataset.glazeName || '';
        const finish = btn.dataset.glazeFinish || '';
        activeGlaze = name;
        if (glazeLabel) glazeLabel.textContent = `${name} (${finish})`;

        for (const other of glazeBtns) {
          const isSelected = other === btn;
          other.setAttribute('aria-pressed', String(isSelected));
          if (isSelected) {
            other.classList.add('border-[var(--color-ink)]', 'bg-[var(--color-surface)]');
            other.classList.remove('border-[var(--color-border)]', 'bg-[var(--color-canvas)]');
          } else {
            other.classList.remove('border-[var(--color-ink)]', 'bg-[var(--color-surface)]');
            other.classList.add('border-[var(--color-border)]', 'bg-[var(--color-canvas)]');
          }
        }
      });
    }

    if (addBtn && addBtn.dataset.bound !== 'true') {
      addBtn.dataset.bound = 'true';
      addBtn.addEventListener('click', () => {
        const slug = addBtn.dataset.slug || '';
        const title = addBtn.dataset.title || '';
        const priceEur = Number(addBtn.dataset.price || '0');

        let bag: Array<{ slug: string; title: string; glaze: string; priceEur: number; qty: number }> = [];
        try {
          const raw = localStorage.getItem('sk-bag');
          bag = raw ? JSON.parse(raw) : [];
          if (!Array.isArray(bag)) bag = [];
        } catch {
          bag = [];
        }

        const existing = bag.find((i) => i.slug === slug && i.glaze === activeGlaze);
        if (existing) {
          existing.qty += 1;
        } else {
          bag.push({ slug, title, glaze: activeGlaze, priceEur, qty: 1 });
        }

        try {
          localStorage.setItem('sk-bag', JSON.stringify(bag));
        } catch {}

        if (addStatus) {
          addStatus.textContent = `Added ${title} (${activeGlaze}) to inquiry bag.`;
        }
        window.dispatchEvent(new CustomEvent('sk-bag-updated'));
        window.dispatchEvent(new CustomEvent('sk-bag-open'));
      });
    }
  }

  document.addEventListener('astro:page-load', setupObjectDetail);
</script>

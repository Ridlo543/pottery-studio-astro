---
import { getEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import handsImg from '../assets/studio/hands.webp';
import wheelImg from '../assets/studio/wheel.webp';
import carvingImg from '../assets/studio/carving.webp';
import shelvesImg from '../assets/studio/shelves.webp';
import footringsImg from '../assets/studio/footrings.webp';
import rawVesselsImg from '../assets/studio/raw-vessels.webp';

const studioEntry = await getEntry('studio', 'profile');
const studio = studioEntry?.data ?? {
  brandName: 'Silt & Kiln',
  headline: 'Wheel-thrown stoneware for dining rooms and architectural interiors.',
  subline: 'Small-batch vessels, tableware, and ceramic lighting thrown and reduction-fired at 1,260°C in Yogyakarta.',
  kilnBatch: 'Kiln Opening No. 14 · Live',
  location: 'Yogyakarta, Indonesia · WIB',
  hours: 'Studio visits by appointment · Thu–Sat 11:00–17:00',
  email: 'studio@siltandkiln.com',
  disclosure: 'Self-initiated ceramic brand & product showcase.',
  craftStages: [],
};

const processGallery = [
  { src: handsImg, alt: 'Potter hands coated in wet grey clay shaping the rim of a stoneware bowl', label: '01 · Rim Shaping' },
  { src: wheelImg, alt: 'Overhead spinning pottery wheel surrounded by clay trimming tools', label: '02 · Momentum Wheel' },
  { src: carvingImg, alt: 'Potter hands carving wet clay vessel on a banding wheel', label: '03 · Surface Carving' },
  { src: footringsImg, alt: 'Inverted stoneware plates showing hand-trimmed raw clay foot rings', label: '04 · Foot Ring Turning' },
  { src: rawVesselsImg, alt: 'Unfired stoneware vessels drying on a studio table before bisque firing', label: '05 · Greenware Drying' },
  { src: shelvesImg, alt: 'Pottery studio drying shelves filled with bisque-fired ceramic vessels', label: '06 · Bisque & Glaze Shelves' },
];
---

<BaseLayout
  title={`Kiln & Craft · ${studio.brandName}`}
  description="Clay bodies, washed teakwood ash glazes, and 1,260°C gas reduction firing at Silt & Kiln."
>
  <section class="pt-10 pb-16 md:pt-14 md:pb-24">
    <div class="studio-wrap">
      <p class="font-mono text-[0.75rem] uppercase tracking-[0.06em] text-[var(--color-muted)]">
        Kiln &amp; Craft · {studio.kilnBatch}
      </p>
      <h1
        data-motion="hero"
        class="mt-4 max-w-[20ch] text-[clamp(2.25rem,4.5vw,3.75rem)] font-normal leading-[1.06] tracking-[-0.035em] text-[var(--color-ink)]"
      >
        Java stoneware, washed wood ash, and 1,260°C reduction firing.
      </h1>
      <p class="mt-5 max-w-[58ch] text-[1.0625rem] leading-[1.65] text-[var(--color-muted)]">
        Every piece begins with raw mineral clay wedged by hand, thrown on a momentum wheel, and fired twice over a five-day cycle.
      </p>

      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-12">
        {processGallery.map((item, idx) => {
          const colClass = idx % 3 === 0 ? 'md:col-span-7 md:h-[440px]' : idx % 3 === 1 ? 'md:col-span-5 md:h-[440px]' : 'md:col-span-12';
          const aspectClass = idx % 3 === 2 ? 'aspect-[16/9] md:aspect-[21/9]' : 'aspect-[4/3] md:aspect-auto md:h-full';
          return (
            <div class={idx % 3 === 2 ? 'md:col-span-12' : idx % 3 === 0 ? 'md:col-span-7' : 'md:col-span-5'}>
              <div class={`overflow-hidden bg-[var(--color-surface)] ${colClass}`}>
                <Picture
                  src={item.src}
                  formats={['avif', 'webp']}
                  fallbackFormat="webp"
                  widths={idx % 3 === 2 ? [480, 760, 1120] : [480, 760]}
                  sizes={idx % 3 === 2 ? '(max-width: 1023px) 100vw, 80vw' : '(max-width: 1023px) 100vw, 45vw'}
                  alt={item.alt}
                  class={`w-full object-cover ${aspectClass}`}
                  loading={idx < 2 ? 'eager' : 'lazy'}
                  decoding={idx < 2 ? 'sync' : 'async'}
                />
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <section aria-labelledby="stages-heading" class="border-t border-[var(--color-border)] bg-[var(--color-surface)] py-16 md:py-24">
    <div class="studio-wrap">
      <h2 id="stages-heading" class="mb-10 text-[2rem] font-medium tracking-[-0.025em] text-[var(--color-ink)]">
        Four-Stage Firing Schedule
      </h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {studio.craftStages.map((stage) => (
          <article class="border border-[var(--color-border)] bg-[var(--color-canvas)] p-6 md:p-8">
            <div class="flex items-center justify-between font-mono text-[0.75rem] text-[var(--color-muted)]">
              <span>Stage {stage.step}</span>
              <span>{stage.temperatureOrDuration}</span>
            </div>
            <h3 class="mt-3 text-[1.5rem] font-medium tracking-[-0.02em] text-[var(--color-ink)]">
              {stage.title}
            </h3>
            <p class="mt-3 text-[1rem] leading-[1.65] text-[var(--color-muted)]">
              {stage.description}
            </p>
            <ul class="mt-5 border-t border-[var(--color-border)] pt-4 text-[0.875rem] text-[var(--color-ink)]">
              {stage.details.map((d) => (
                <li class="py-1">{d}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

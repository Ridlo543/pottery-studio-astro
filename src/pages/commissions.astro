---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const studioEntry = await getEntry('studio', 'profile');
const studio = studioEntry?.data ?? {
  brandName: 'Silt & Kiln',
  headline: 'Wheel-thrown stoneware for dining rooms and architectural interiors.',
  subline: 'Small-batch vessels, tableware, and ceramic lighting thrown and reduction-fired at 1,260°C in Yogyakarta.',
  kilnBatch: 'Kiln Opening No. 14 · Live',
  location: 'Yogyakarta, Indonesia · WIB',
  hours: 'Studio visits by appointment · Thu–Sat 11:00–17:00',
  email: 'studio@siltandkiln.com',
  disclosure: 'Self-initiated ceramic brand & product showcase.',
  craftStages: [],
};
---

<BaseLayout
  title={`Commissions & Orders · ${studio.brandName}`}
  description={`Order stoneware objects or request custom hospitality tableware runs from ${studio.brandName}.`}
>
  <section class="pt-10 pb-20 md:pt-14 md:pb-28">
    <div class="studio-wrap grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-6 md:col-span-5">
        <p class="font-mono text-[0.75rem] uppercase tracking-[0.06em] text-[var(--color-muted)]">
          Orders &amp; Trade · {studio.location}
        </p>
        <h1
          data-motion="hero"
          class="text-[clamp(2.25rem,4.5vw,3.5rem)] font-normal leading-[1.06] tracking-[-0.035em] text-[var(--color-ink)]"
        >
          Order kiln pieces or commission custom tableware.
        </h1>
        <p class="max-w-[44ch] text-[1rem] leading-[1.65] text-[var(--color-muted)]">
          Submit your selected inquiry bag items, request glaze test tiles for hospitality projects, or schedule a studio visit in Yogyakarta.
        </p>

        <div class="mt-2 border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
          <p class="font-mono text-[0.75rem] uppercase tracking-[0.06em] text-[var(--color-muted)]">
            Studio Desk
          </p>
          <div class="mt-3 flex flex-wrap items-center gap-3">
            <a
              href={`mailto:${studio.email}`}
              class="inline-flex min-h-[44px] items-center text-[1.125rem] font-medium text-[var(--color-accent)] underline underline-offset-4"
            >
              {studio.email}
            </a>
            <button
              type="button"
              id="copy-email-btn"
              data-email={studio.email}
              class="inline-flex min-h-[44px] items-center rounded-[2px] border border-[var(--color-border)] bg-[var(--color-canvas)] px-3.5 text-[0.875rem] font-medium text-[var(--color-ink)] hover:border-[var(--color-ink)]"
            >
              Copy email
            </button>
          </div>
          <p id="copy-email-status" role="status" aria-live="polite" class="mt-2 font-mono text-[0.75rem] text-[var(--color-muted)]">
            {studio.hours}
          </p>
        </div>
      </div>

      <div id="enquiry" class="md:col-span-7">
        <form
          id="commission-enquiry-form"
          action={`mailto:${studio.email}`}
          method="get"
          novalidate
          class="border border-[var(--color-border)] bg-[var(--color-surface)] p-6 md:p-10"
        >
          <h2 class="text-[1.5rem] font-medium tracking-[-0.02em] text-[var(--color-ink)]">
            Order &amp; Commission Request
          </h2>
          <p class="mt-2 text-[0.9375rem] text-[var(--color-muted)]">
            Any objects added to your inquiry bag are attached automatically below.
          </p>

          <div id="bag-summary-box" hidden class="mt-6 border border-[var(--color-border)] bg-[var(--color-canvas)] p-4">
            <p class="font-mono text-[0.75rem] uppercase tracking-[0.05em] text-[var(--color-accent)]">
              Selected Inquiry Bag Items
            </p>
            <p id="bag-summary-text" class="mt-1.5 font-mono text-[0.8125rem] text-[var(--color-ink)]"></p>
          </div>

          <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div>
              <label for="enquiry-name" class="block text-[0.875rem] font-medium text-[var(--color-ink)]">
                Your name <span class="text-[var(--color-accent)]">*</span>
              </label>
              <input
                id="enquiry-name"
                name="name"
                type="text"
                autocomplete="name"
                required
                aria-describedby="enquiry-name-error"
                class="mt-2 min-h-[48px] w-full rounded-[2px] border border-[var(--color-border)] bg-[var(--color-canvas)] px-4 text-[1rem] text-[var(--color-ink)]"
              />
              <p id="enquiry-name-error" class="mt-1.5 text-[0.8125rem] text-[var(--color-error)]" hidden></p>
            </div>

            <div>
              <label for="enquiry-email" class="block text-[0.875rem] font-medium text-[var(--color-ink)]">
                Email address <span class="text-[0.875rem] text-[var(--color-accent)]">*</span>
              </label>
              <input
                id="enquiry-email"
                name="email"
                type="email"
                autocomplete="email"
                required
                aria-describedby="enquiry-email-error"
                class="mt-2 min-h-[48px] w-full rounded-[2px] border border-[var(--color-border)] bg-[var(--color-canvas)] px-4 text-[1rem] text-[var(--color-ink)]"
              />
              <p id="enquiry-email-error" class="mt-1.5 text-[0.8125rem] text-[var(--color-error)]" hidden></p>
            </div>
          </div>

          <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div>
              <label for="enquiry-type" class="block text-[0.875rem] font-medium text-[var(--color-ink)]">
                Inquiry type
              </label>
              <select
                id="enquiry-type"
                name="type"
                class="mt-2 min-h-[48px] w-full rounded-[2px] border border-[var(--color-border)] bg-[var(--color-canvas)] px-4 text-[1rem] text-[var(--color-ink)]"
              >
                <option value="Kiln Opening No. 14 Order">Kiln Opening No. 14 Order</option>
                <option value="Hospitality Tableware Run">Hospitality Tableware Run</option>
                <option value="Architectural Vessel Commission">Architectural Vessel Commission</option>
                <option value="Studio Visit Appointment">Studio Visit Appointment</option>
              </select>
            </div>

            <div>
              <label for="enquiry-shipping" class="block text-[0.875rem] font-medium text-[var(--color-ink)]">
                Delivery region
              </label>
              <select
                id="enquiry-shipping"
                name="shipping"
                class="mt-2 min-h-[48px] w-full rounded-[2px] border border-[var(--color-border)] bg-[var(--color-canvas)] px-4 text-[1rem] text-[var(--color-ink)]"
              >
                <option value="Jabodetabek & Java">Jabodetabek &amp; Java</option>
                <option value="Bali & Nusa Tenggara">Bali &amp; Nusa Tenggara</option>
                <option value="Sumatra, Kalimantan & Sulawesi">Sumatra, Kalimantan &amp; Sulawesi</option>
                <option value="International Shipping">International Shipping</option>
                <option value="Studio Pickup (Yogyakarta)">Studio Pickup (Yogyakarta)</option>
              </select>
            </div>
          </div>

          <div class="mt-6">
            <label for="enquiry-notes" class="block text-[0.875rem] font-medium text-[var(--color-ink)]">
              Quantities, glaze notes, or project timeline <span class="text-[var(--color-accent)]">*</span>
            </label>
            <textarea
              id="enquiry-notes"
              name="notes"
              rows="4"
              required
              aria-describedby="enquiry-notes-error"
              class="mt-2 w-full rounded-[2px] border border-[var(--color-border)] bg-[var(--color-canvas)] p-4 text-[1rem] text-[var(--color-ink)]"
            ></textarea>
            <p id="enquiry-notes-error" class="mt-1.5 text-[0.8125rem] text-[var(--color-error)]" hidden></p>
          </div>

          <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <button
              type="submit"
              class="inline-flex min-h-[48px] items-center justify-center rounded-[2px] bg-[var(--color-accent)] px-6 text-[0.9375rem] font-medium text-[var(--color-accent-on)] hover:bg-[var(--color-accent-hover)]"
            >
              Prepare order inquiry
            </button>
            <p class="text-[0.8125rem] text-[var(--color-muted)]">
              Opens a pre-filled mailto draft in your mail client.
            </p>
          </div>

          <p
            id="enquiry-form-status"
            role="status"
            aria-live="polite"
            class="mt-4 text-[0.9375rem] font-medium text-[var(--color-ink)]"
          ></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function setupCommissionsPage() {
    const copyBtn = document.getElementById('copy-email-btn') as HTMLButtonElement | null;
    const copyStatus = document.getElementById('copy-email-status');
    if (copyBtn && copyBtn.dataset.bound !== 'true') {
      copyBtn.dataset.bound = 'true';
      copyBtn.addEventListener('click', async () => {
        const email = copyBtn.dataset.email || '';
        if (copyStatus) copyStatus.textContent = `Selected ${email}`;
        try {
          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(email);
            if (copyStatus) copyStatus.textContent = `Copied ${email}`;
          }
        } catch {
          if (copyStatus) copyStatus.textContent = email;
        }
      });
    }

    const bagBox = document.getElementById('bag-summary-box');
    const bagText = document.getElementById('bag-summary-text');
    const notesInput = document.getElementById('enquiry-notes') as HTMLTextAreaElement | null;

    const syncBagSummary = () => {
      let bag: Array<{ title: string; glaze: string; priceIdr: number; qty: number }> = [];
      try {
        const raw = localStorage.getItem('sk-bag');
        bag = raw ? JSON.parse(raw) : [];
        if (!Array.isArray(bag)) bag = [];
      } catch {
        bag = [];
      }

      if (bagBox && bagText) {
        if (bag.length > 0) {
          const summary = bag.map((i) => `${i.qty}x ${i.title} (${i.glaze}, Rp ${((i.priceIdr || 0) * i.qty).toLocaleString('id-ID')})`).join(' · ');
          bagText.textContent = summary;
          bagBox.hidden = false;
          if (notesInput && !notesInput.value.trim()) {
            notesInput.value = `Selected pieces: ${summary}`;
          }
        } else {
          bagBox.hidden = true;
        }
      }
    };
    syncBagSummary();
    window.addEventListener('sk-bag-updated', syncBagSummary);

    const form = document.getElementById('commission-enquiry-form') as HTMLFormElement | null;
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const nameInput = document.getElementById('enquiry-name') as HTMLInputElement;
    const emailInput = document.getElementById('enquiry-email') as HTMLInputElement;
    const typeInput = document.getElementById('enquiry-type') as HTMLSelectElement;
    const shipInput = document.getElementById('enquiry-shipping') as HTMLSelectElement;
    const statusEl = document.getElementById('enquiry-form-status');

    const setFieldError = (input: HTMLElement, errorId: string, message: string) => {
      const errEl = document.getElementById(errorId);
      if (message) {
        input.setAttribute('aria-invalid', 'true');
        if (errEl) {
          errEl.textContent = message;
          errEl.hidden = false;
        }
      } else {
        input.removeAttribute('aria-invalid');
        if (errEl) {
          errEl.textContent = '';
          errEl.hidden = true;
        }
      }
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      let firstInvalid: HTMLElement | null = null;
      let errorCount = 0;

      const nameVal = nameInput.value.trim();
      if (!nameVal) {
        setFieldError(nameInput, 'enquiry-name-error', 'Enter your name.');
        firstInvalid = firstInvalid || nameInput;
        errorCount += 1;
      } else {
        setFieldError(nameInput, 'enquiry-name-error', '');
      }

      const emailVal = emailInput.value.trim();
      if (!emailVal || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailVal)) {
        setFieldError(emailInput, 'enquiry-email-error', 'Enter a valid email address with an @.');
        firstInvalid = firstInvalid || emailInput;
        errorCount += 1;
      } else {
        setFieldError(emailInput, 'enquiry-email-error', '');
      }

      const notesVal = (notesInput?.value || '').trim();
      if (notesVal.length < 10 && notesInput) {
        setFieldError(notesInput, 'enquiry-notes-error', 'Write at least 10 characters describing your order or commission.');
        firstInvalid = firstInvalid || notesInput;
        errorCount += 1;
      } else if (notesInput) {
        setFieldError(notesInput, 'enquiry-notes-error', '');
      }

      if (errorCount > 0) {
        if (statusEl) {
          statusEl.textContent = `Please fix ${errorCount} highlighted ${errorCount === 1 ? 'field' : 'fields'} above.`;
        }
        firstInvalid?.focus();
        return;
      }

      const subject = encodeURIComponent(`[Silt & Kiln] ${typeInput.value} - ${nameVal}`);
      const body = encodeURIComponent(
        `Name: ${nameVal}\nEmail: ${emailVal}\nInquiry Type: ${typeInput.value}\nDelivery Region: ${shipInput.value}\n\nDetails:\n${notesVal}`
      );
      const target = form.getAttribute('action') || 'mailto:studio@siltandkiln.com';
      if (statusEl) {
        statusEl.textContent = 'Mailto draft prepared. If your mail client did not open, copy studio@siltandkiln.com above.';
      }
      window.location.href = `${target}?subject=${subject}&body=${body}`;
    });
  }

  document.addEventListener('astro:page-load', setupCommissionsPage);
</script>

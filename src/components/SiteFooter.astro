---
import BrandMark from './BrandMark.astro';

interface Props {
  brandName: string;
  email: string;
  location: string;
  hours: string;
  disclosure: string;
}

const { brandName, email, location, hours, disclosure } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-border)] bg-[var(--color-canvas)] py-14 md:py-20">
  <div class="studio-wrap flex flex-col gap-12">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-12 md:items-start">
      <div class="flex flex-col gap-4 md:col-span-7">
        <p class="font-mono text-[0.75rem] uppercase tracking-[0.06em] text-[var(--color-muted)]">
          Hospitality &amp; Architectural Commissions
        </p>
        <h2 class="max-w-[20ch] text-[clamp(1.75rem,3.2vw,2.75rem)] font-normal leading-[1.1] tracking-[-0.03em] text-[var(--color-ink)]">
          Custom tableware runs and architectural vessels fired to order.
        </h2>
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a
            href="/commissions"
            class="inline-flex min-h-[44px] items-center rounded-[2px] bg-[var(--color-accent)] px-5 text-[0.9375rem] font-medium text-[var(--color-accent-on)] hover:bg-[var(--color-accent-hover)]"
          >
            Request a commission
          </a>
          <a
            href={`mailto:${email}`}
            class="inline-flex min-h-[44px] items-center rounded-[2px] border border-[var(--color-border)] px-5 text-[0.9375rem] font-medium text-[var(--color-ink)] hover:border-[var(--color-ink)]"
          >
            {email}
          </a>
        </div>
      </div>

      <div class="flex flex-col gap-2.5 md:col-span-5 md:items-end md:text-right">
        <a
          href="/"
          class="inline-flex min-h-[44px] items-center gap-2.5 text-[1rem] font-semibold uppercase tracking-[0.05em] text-[var(--color-ink)]"
        >
          <BrandMark size={20} />
          <span>{brandName}</span>
        </a>
        <p class="font-mono text-[0.75rem] text-[var(--color-muted)]">{location}</p>
        <p class="text-[0.875rem] text-[var(--color-muted)]">{hours}</p>
        <p class="max-w-[42ch] text-[0.8125rem] text-[var(--color-muted)]">{disclosure}</p>
      </div>
    </div>

    <div class="flex flex-col justify-between gap-4 border-t border-[var(--color-border)] pt-6 text-[0.875rem] text-[var(--color-muted)] sm:flex-row sm:items-center">
      <p>© {year} {brandName}. All rights reserved.</p>
      <nav aria-label="Footer navigation" class="flex flex-wrap items-center gap-6">
        <a href="/" class="inline-flex min-h-[44px] items-center hover:text-[var(--color-ink)]">Objects</a>
        <a href="/craft" class="inline-flex min-h-[44px] items-center hover:text-[var(--color-ink)]">Kiln &amp; Craft</a>
        <a href="/studio" class="inline-flex min-h-[44px] items-center hover:text-[var(--color-ink)]">Studio</a>
        <a href="/commissions" class="inline-flex min-h-[44px] items-center hover:text-[var(--color-ink)]">Commissions</a>
        <a href="/credits" class="inline-flex min-h-[44px] items-center hover:text-[var(--color-ink)]">
          Photo credits
        </a>
      </nav>
    </div>
  </div>
</footer>
